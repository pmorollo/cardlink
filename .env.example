PORT=3000
# Com "*" todas as origens são aceitas. Use uma lista em produção, ex.: https://meusite.com.br
CORS_ORIGIN=*
JWT_SECRET=your_secret_here
# URL pública usada nos links de ativação enviados após o pagamento
# PUBLIC_APP_URL=https://seu-dominio-cardlink.com.br
# Administradores não são definidos por variável de e-mail.
# Use manualmente: npm run admin:set -- email@exemplo.com

# Banco PostgreSQL (opcional). Se ausente, usa backend/db/data.json local.
# DATABASE_URL=postgres://usuario:senha@host:5432/db

# Integração NVIDIA para o assistente de conteúdo (opcional).
# NVIDIA_API_KEY=

# Resend via API HTTPS (recomendado em ambientes que bloqueiam portas SMTP)
# RESEND_API_KEY=re_xxxxxxxxx
# EMAIL_FROM="CardLink <cardlink@seu-dominio.com>"

# Servidor SMTP alternativo para envio de notificações e redefinição de senhas
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=seu-email@gmail.com
# SMTP_PASS=sua-senha-de-app
# SMTP_FROM="CardLink <seu-email@gmail.com>"

# Chave secreta de validação para o webhook da Cakto (opcional)
# CAKTO_SECRET=chave_secreta_webhook_cakto
# Credenciais OAuth2 da Cakto API. Necessárias para consultar produtos/ofertas
# e criar de forma idempotente a oferta anual do CardLink.
# A chave precisa dos escopos: read products, read offers, write offers.
# O escopo read webhooks é opcional e permite conferir o vínculo existente.
# CAKTO_CLIENT_ID=
# CAKTO_CLIENT_SECRET=
# Fallbacks opcionais caso a API esteja temporariamente indisponível:
# CAKTO_MONTHLY_CHECKOUT_URL=https://pay.cakto.com.br/id_oferta_mensal
# CAKTO_ANNUAL_CHECKOUT_URL=https://pay.cakto.com.br/id_oferta_anual

# Armazenamento Cloudflare R2 para fotos de uploads (opcional)
# R2_ACCESS_KEY_ID=r2_access_key
# R2_SECRET_ACCESS_KEY=r2_secret_key
# CLOUDFLARE_ACCOUNT_ID=cloudflare_account_id
