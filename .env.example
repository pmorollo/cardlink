PORT=3000
# Com "*" todas as origens são aceitas. Use uma lista em produção, ex.: https://meusite.com.br
CORS_ORIGIN=*
JWT_SECRET=your_secret_here
# E-mails autorizados como administradores da plataforma (separados por vírgula).
ADMIN_EMAILS=pedro.morollo@gmail.com
# Banco PostgreSQL (opcional). Se ausente, usa backend/db/data.json local.
# DATABASE_URL=postgres://usuario:senha@host:5432/db
# Integração NVIDIA para o assistente de conteúdo (opcional).
# NVIDIA_API_KEY=