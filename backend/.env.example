# ==============================================================================
# CARDLINK BACKEND — VARIÁVEIS DE AMBIENTE (MODELO DE EXEMPLO)
# NUNCA insira credenciais reais neste arquivo.
# No Railway, configure estas variáveis diretamente na aba "Variables".
# ==============================================================================

NODE_ENV=production
PORT=3000
PUBLIC_APP_URL=https://cardlink.digitalnexoapp.com
CORS_ORIGIN=https://cardlink.digitalnexoapp.com

# Autenticação
JWT_SECRET=substitua_por_uma_chave_secreta_longa_e_aleatoria_de_128_caracteres

# Banco de Dados (PostgreSQL obrigatório em produção)
DATABASE_URL=postgresql://usuario:senha@host:porta/database

# Pagamentos Cakto — CAKTO_SECRET obrigatório em produção
CAKTO_SECRET=seu_segredo_de_webhook_cakto
CAKTO_CLIENT_ID=seu_client_id_cakto
CAKTO_CLIENT_SECRET=seu_client_secret_cakto
CAKTO_MONTHLY_CHECKOUT_URL=https://pay.cakto.com.br/checkout-mensal
CAKTO_ANNUAL_CHECKOUT_URL=https://pay.cakto.com.br/checkout-anual

# Storage Cloudflare R2
CLOUDFLARE_ACCOUNT_ID=seu_account_id_cloudflare
R2_ACCESS_KEY_ID=sua_access_key_r2
R2_SECRET_ACCESS_KEY=sua_secret_key_r2
R2_BUCKET=cardlink-uploads
R2_PUBLIC_URL=https://pub-id.r2.dev

# E-mail
RESEND_API_KEY=re_sua_chave_resend
EMAIL_FROM=CardLink <contato@digitalnexoapp.com>

# IA
GEMINI_API_KEY=sua_chave_gemini_aqui
